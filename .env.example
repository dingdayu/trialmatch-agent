# TrialMatch AI 环境变量模板 — 对应 Task 22.1
# 复制此文件为 .env 并修改配置

# ========== 应用 ==========
APP_NAME=TrialMatch AI
APP_VERSION=0.1.0
DEBUG=true

# ========== 数据库 (SQLite) ==========
DATABASE_URL=sqlite+aiosqlite:///./resource/trialmatch.db

# ========== JWT ==========
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRE_SECONDS=86400

# ========== 文件上传 ==========
UPLOAD_DIR=./resource/uploads
MAX_UPLOAD_SIZE_MB=50

# ========== LLM 配置 ==========
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-api-key
LLM_MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
